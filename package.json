{
  "name": "jarvis-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@jarvis/web",
    "dev:daemon": "npm run dev --workspace=@jarvis/daemon",
    "dev:web": "npm run dev --workspace=@jarvis/web"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "openai": "^4.28.0"
  }
}
