# ==============================================================================
# JARVIS - Git Ignore Rules
# ==============================================================================

# --- Dependências de Pacotes (Monorepo Workspaces) ---
node_modules/
.pnp
.pnp.js

# --- Segredos & Variáveis de Ambiente ---
# NUNCA comitar chaves de API ou segredos
.env
.env.local
.env.*.local
*.env

# --- Compilação & Builds ---
dist/
build/
out/
*.tsbuildinfo

# --- Artefatos de Execução e Banco de Dados Local ---
# Persistência do Daemon (SQLite) e configurações locais
*.db
*.db-journal
*.db-wal
*.db-shm
jarvis.db

# --- Sandboxes, Diretórios Temporários & Protegidos do JARVIS ---
# Diretórios gerados pelo VaultFSSandbox e I/O atômico
.jarvis/
.jarvis-tmp/
*.tmp
*.temp

# --- Artefatos do Obsidian & Metadados Locais ---
# Se rodar testes apontando para vaults locais reais
.obsidian/
.trash/

# --- Logs & Depuração ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Testes & Cobertura ---
coverage/
.vitest/

# --- IDEs & Editores de Sistema ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# --- Arquivos de Sistema Operacional ---
.DS_Store
Thumbs.db
desktop.ini
*~